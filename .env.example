# ---- Pi Network ----
# Production is Pi MAINNET. Anything other than an explicit "testnet" means mainnet.
# Use "testnet" only for a separate staging copy (with ALLOW_TESTNET_PAYMENTS=true, a Testnet Pi app and its own database).
NEXT_PUBLIC_PI_NETWORK=mainnet
# true when running inside Pi Sandbox (localhost development), false in Pi Browser.
NEXT_PUBLIC_PI_SANDBOX=false
# Server-only. Generate in Pi Developers -> your app -> Settings -> API key.
PI_API_KEY=
# Your app's PiNet URL (https://<subdomain>.pinet.com). Used for shared links and invites.
NEXT_PUBLIC_PINET_URL=https://healthai4171.pinet.com

# ---- Supabase (server-only; the browser never talks to Supabase directly) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Session / admin ----
# Long random string (32+ chars) used to sign the session cookie.
SESSION_SECRET=
# Comma-separated Pi usernames allowed into /admin.
ADMIN_USERNAMES=

# ---- AI provider (server-only). Without a key the AI features show "service not configured". ----
# meta (default, Meta Model API) | anthropic | openai (any OpenAI-compatible endpoint)
AI_PROVIDER=meta
# Meta: muse-ember-1.0 (default)
AI_MODEL=muse-ember-1.0
# Muse Ember always reasons: none is rejected; low keeps it fast
AI_REASONING_EFFORT=low
AI_API_KEY=
# Web search for unfamiliar dishes: off (default, faster) | on
# AI_WEB_SEARCH=off
# Optional: override base URL (required for non-default OpenAI-compatible hosts)
AI_BASE_URL=

# ---- Optional price overrides. Defaults live in src/config/pricing.ts ----
# PRICE_PLAN_USD / PRICE_PACK_SMALL_USD / PRICE_PACK_LARGE_USD set the live USD targets;
# PRICE_PLAN_PI / PRICE_PACK_SMALL_PI / PRICE_PACK_LARGE_PI are used only with PRICING_MODE=fixed.

# ---- Local development / staging only. Never set in production. ----
# ALLOW_DEV_LOGIN=true
# ALLOW_TESTNET_PAYMENTS=true
# ---- KYC: "off" (default; Pi's API exposes no KYC flag) | "strict" ----
# PI_KYC_MODE=off
# ---- USD per Pi used only if the live rate feed is unreachable ----
# PI_PRICE_FALLBACK_USD=0.05

# ---- Pricing (see src/config/pricing.ts) ----
# PRICING_MODE=live (default; USD converted at the live rate) | fixed (uses PRICE_*_PI, handy on Testnet)

# ---- AI limits ----
# AI_LIMIT_PER_HOUR=6
# AI_LIMIT_PER_DAY=30
# AI_GLOBAL_DAILY_CAP=2000

# ---- Pi Sign-In (OAuth) for ordinary browsers: public client id from Pi Developers (optional override) ----
# NEXT_PUBLIC_PI_CLIENT_ID=
# ---- Web Push reminders (VAPID): generate with `npx web-push generate-vapid-keys` ----
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://your-app.example

# ---- Hourly reminder scheduler (pg_cron): same value as in supabase/scheduler.sql ----
# SCHEDULER_SECRET=

# ---- Cron (Vercel sends this as a Bearer token to /api/cron/maintenance) ----
CRON_SECRET=
