# ---- Pi Network ----
# "testnet" (default) or "mainnet". Mainnet is out of scope for this task.
NEXT_PUBLIC_PI_NETWORK=testnet
# true when running inside Pi Sandbox (localhost development), false in Pi Browser.
NEXT_PUBLIC_PI_SANDBOX=false
# Server-only. Generate in Pi Developers -> your app -> Settings -> API key.
PI_API_KEY=
# Your PiNet URL (https://<subdomain>.pinet.com). Used for shared recipe links.
NEXT_PUBLIC_PINET_URL=

# ---- Supabase (server-only; the browser never talks to Supabase directly) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Session / admin ----
# Long random string (32+ chars) used to sign the session cookie.
SESSION_SECRET=
# Comma-separated Pi usernames allowed into /admin.
ADMIN_USERNAMES=

# ---- AI provider (server-only). Without a key the AI features show "service not configured". ----
# meta (default, Meta Model API) | anthropic | openai (any OpenAI-compatible endpoint)
AI_PROVIDER=meta
# Meta: muse-ember-1.0 (default)
AI_MODEL=muse-ember-1.0
# Muse Ember always reasons: none is rejected; low keeps it fast
AI_REASONING_EFFORT=low
AI_API_KEY=
# Optional: override base URL (required for non-default OpenAI-compatible hosts)
AI_BASE_URL=

# ---- Optional price overrides (Pi). Defaults live in src/config/pricing.ts ----
# PRICE_PLAN_PI=3
# PRICE_PACK_SMALL_PI=1
# PRICE_PACK_LARGE_PI=2.5

# ---- Local development only. Never set in production. ----
# ALLOW_DEV_LOGIN=true

# ---- Pricing (see src/config/pricing.ts) ----
# PRICING_MODE=live (default) | fixed (uses PRICE_*_PI, handy on Testnet)

# ---- AI limits ----
# AI_LIMIT_PER_HOUR=6
# AI_LIMIT_PER_DAY=30
# AI_GLOBAL_DAILY_CAP=2000

# ---- Cron (Vercel sends this as a Bearer token to /api/cron/maintenance) ----
CRON_SECRET=
